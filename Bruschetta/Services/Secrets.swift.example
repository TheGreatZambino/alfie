enum Secrets {
    /// Free key from https://api.data.gov/signup/ — leave empty to use Open Food Facts only.
    static let usdaAPIKey = ""

    /// From telemetrydeck.com's dashboard after creating an app — leave empty to disable analytics.
    static let telemetryDeckAppID = ""

    /// AdMob app ID, from apps.admob.com. Set to Google's public test app ID by default —
    /// swap in the real one before shipping.
    static let admobAppID = "ca-app-pub-3940256099942544~1458002511"

    /// AdMob banner ad unit ID. Set to Google's public test banner unit by default —
    /// swap in the real one before shipping.
    static let admobBannerAdUnitID = "ca-app-pub-3940256099942544/2934735716"

    /// Must exactly match the auto-renewable subscription product ID created in App Store Connect.
    static let removeAdsSubscriptionProductID = "alfie.removeads.monthly"
}
